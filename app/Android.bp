android_app {
    name: "SystemInstaller",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "androidx.activity_activity-compose",
        "androidx.compose.foundation_foundation",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material-icons-core",
        "androidx.compose.material_material-icons-extended",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "device.mainline.generic.installer-java",
    ],
    required: [
        "privapp-permissions-device.mainline.generic.installer.xml",
        "systeminstallerd",
    ],
    optimize: {
        enabled: false,
    },
}

prebuilt_etc {
    name: "privapp-permissions-device.mainline.generic.installer.xml",
    src: "privapp-permissions-device.mainline.generic.installer.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
