sh_binary {
    name: "systeminstaller",
    src: "systeminstaller.sh",
    system_ext_specific: true,
    required: [
        "systeminstaller_grub",
        "systeminstaller_lib",
    ],
}

prebuilt_etc {
    name: "systeminstaller_lib",
    srcs: ["lib/*.sh"],
    sub_dir: "systeminstaller/lib",
    system_ext_specific: true,
}
