cc_binary {
    name: "systeminstallerd",
    srcs: ["systeminstallerd.cpp"],
    init_rc: ["systeminstallerd.rc"],
    system_ext_specific: true,
    header_libs: ["libcutils_headers"],
    shared_libs: [
        "device.mainline.generic.installer-ndk",
        "libbase",
        "libbinder_ndk",
        "liblog",
    ],
    required: ["systeminstaller"],
}
